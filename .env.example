# Copy this file to .env and fill in YOUR OWN values. .env is git-ignored; never commit it.
# Every value below is a placeholder. See docs/environment-config-reference.md for details.

# Postgres with pgvector. On Supabase, use the *transaction pooler* URL (port 6543).
DATABASE_URL=

# https://platform.openai.com/api-keys (answers, writing jobs and embeddings)
OPENAI_API_KEY=

# https://typesafe.ai (Jev, which assigns companies to subcategories)
TYPESAFE_API_KEY=

# The site password. Leave it empty locally to switch the gate off; always set it when deployed.
APP_PASSWORD=

# Protects the daily refresh endpoint. Generate one with: openssl rand -hex 32
CRON_SECRET=

# Optional. "off" skips fetching founders from YC company pages.
FOUNDERS_FETCH=on

# Tests only: a throwaway database (npm run db:test:up starts one). Never point it at real data.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:54329/whatstir_test

# Leave these unset outside tests: AI_FAKE (fake AI answers) and YC_SOURCE_URL (overrides the yc-oss feed).
