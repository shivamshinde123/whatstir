# Copy this file to .env and fill in YOUR OWN values. .env is git-ignored; never commit it.
# Every value below is a placeholder. See docs/environment-config-reference.md for details.

# Postgres with pgvector. On Supabase, use the *transaction pooler* URL (port 6543).
DATABASE_URL=

# Where answers, writing and embeddings come from: "openai" (default) or "openrouter".
AI_PROVIDER=openai

# With AI_PROVIDER=openai: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# With AI_PROVIDER=openrouter: https://openrouter.ai/keys (one key, models from many vendors)
OPENROUTER_API_KEY=

# Optional model overrides. Leave empty for the provider's defaults (OpenRouter ids look like
# "openai/gpt-6.1-sol"; browse https://openrouter.ai/models). Answer and writing models must support
# structured outputs. The embedding model must produce 1536 dimensions; changing it means re-embedding.
AI_MODEL_ANSWER=
AI_MODEL_WRITE=
AI_MODEL_EMBED=

# https://typesafe.ai (Jev, which assigns companies to subcategories)
TYPESAFE_API_KEY=
# Optional: pin a Jev model instead of jev-latest.
JEV_MODEL=

# The site password. Leave it empty locally to switch the gate off; always set it when deployed.
APP_PASSWORD=

# Protects the daily refresh endpoint. Generate one with: openssl rand -hex 32
CRON_SECRET=

# Optional, off by default. "on" fetches founders from YC company pages, which YC's terms of use
# forbid (scraping). Only turn it on for your own private use, at your own risk.
FOUNDERS_FETCH=off

# Tests only: a throwaway database (npm run db:test:up starts one). Never point it at real data.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:54329/whatstir_test

# Leave these unset outside tests: AI_FAKE (fake AI answers) and YC_SOURCE_URL (overrides the yc-oss feed).
