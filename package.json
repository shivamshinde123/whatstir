{
  "name": "whatstir",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "ci": "npm run typecheck && npm run lint && npm run test && npm run test:e2e",
    "migrate": "tsx --env-file=.env scripts/migrate.mts",
    "db:test:up": "docker start whatstir-test-db || docker run -d --name whatstir-test-db -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=whatstir_test -p 54329:5432 pgvector/pgvector:pg16"
  },
  "dependencies": {
    "next": "16.4.4",
    "postgres": "^4.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10",
    "@testing-library/jest-dom": "^7",
    "@testing-library/react": "^16",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "jsdom": "^30",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5"
  }
}
